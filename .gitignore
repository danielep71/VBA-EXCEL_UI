#==============================================================================
# VBA-EXCEL_UI .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Ignore local, temporary, generated, sensitive, and release-binary files
#   while keeping exported VBA source, documentation, tests, and repository
#   assets reviewable as text wherever practical.
#
# POLICY
#   - Exported VBA modules remain version-controlled.
#   - Demo .xlsm workbooks are NOT version-controlled.
#   - Tested macro-enabled demo workbooks are distributed as GitHub Release
#     assets only.
#   - Office lock files, editor state, logs, build output, and local secrets do
#     not belong in the repository.
#==============================================================================

#------------------------------------------------------------------------------
# MICROSOFT OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
~$*
~$*.xls*
~$*.doc*
~$*.ppt*
*.tmp
*.temp
*.bak
*.backup
*.xlk
*.asd
*.wbk

# LibreOffice-style lock files that may appear during cross-tool inspection
.~lock.*#

#------------------------------------------------------------------------------
# DEMO / RELEASE BINARY WORKBOOKS
#------------------------------------------------------------------------------
# Keep demo source modules in Git, but publish tested macro-enabled workbooks
# only as GitHub Release assets.
demo/*.xlsm

# Optional local staging area for release binaries/checksums.
release-assets/

#------------------------------------------------------------------------------
# WINDOWS / MACOS / FILE-SYSTEM METADATA
#------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.stackdump

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

#------------------------------------------------------------------------------
# EDITOR / IDE LOCAL SETTINGS
#------------------------------------------------------------------------------
.vscode/
.idea/
.vs/
.history/
*.code-workspace
*.swp
*.swo
*~

# Notepad++ and similar editor backup/session files
*.nppBackup
session.xml

#------------------------------------------------------------------------------
# LOGS / DIAGNOSTIC DUMPS
#------------------------------------------------------------------------------
*.log
*.dmp
*.dump

#------------------------------------------------------------------------------
# GENERATED / LOCAL OUTPUT DIRECTORIES
#------------------------------------------------------------------------------
build/
dist/
output/
outputs/
temp/
tmp/
test-output/
test-results/
coverage/

#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET MATERIAL
#------------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key

#------------------------------------------------------------------------------
# PYTHON CACHE / LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# Release, validation, or repository-maintenance scripts may be added later.
# Source scripts themselves remain trackable.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

#------------------------------------------------------------------------------
# KEEP THESE REPOSITORY ASSETS TRACKABLE
#------------------------------------------------------------------------------
# Exported VBA source:
#   *.bas
#   *.cls
#   *.frm
#   *.frx
#
# Demo source:
#   demo/M_EXCEL_UI_DEMO.bas
#   demo/M_DEMO_BUILDER.bas
#
# Documentation and governance:
#   *.md
#   *.txt
#
# Repository configuration:
#   .gitignore
#   .gitattributes
#
# Images:
#   images/*
#
# Do not add broad rules such as *.bas or images/ to this file.
# Do not commit demo .xlsm files; distribute them as GitHub Release assets.
