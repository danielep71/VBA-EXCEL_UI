#==============================================================================
# VBA-EXCEL_UI .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Keep the repository source-first, reviewable, and safe to clone.
#
#   Ignore local, temporary, generated, sensitive, and release-binary files
#   while preserving the exported VBA source, demo builders, regression tests,
#   repository tooling, documentation, workflows, and screenshots that define
#   the project.
#
# REPOSITORY POLICY
#   - Exported VBA source is version-controlled.
#   - Demo workbook SOURCE is version-controlled.
#   - Generated .xlsm / .xlam and other Excel binaries are NOT source files.
#   - Tested binaries and certification evidence are distributed through the
#     GitHub Release process, not committed from a workstation.
#   - Editor state, logs, caches, build output, local secrets, Office lock files,
#     and OS metadata do not belong in Git.
#   - tools/check_repo.py validates the tracked-file set against the blocked
#     artifact patterns below. Ignored local release files remain permissible.
#
# SAFETY RULE
#   Do not add broad rules that can hide:
#
#       *.bas  *.cls  *.frm  *.frx  *.py  *.xml  *.md  *.txt
#       src/   demo/  test/  tools/  docs/  images/  .github/
#
#   Those paths contain authoritative source or repository evidence.
#==============================================================================


#------------------------------------------------------------------------------
# MICROSOFT OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
# Office creates owner and lock files beside open workbooks and documents.
# The general ~$* rule covers the Excel, Word and PowerPoint variants.
#------------------------------------------------------------------------------

~$*
*.laccdb
*.ldb

*.tmp
*.temp
*.bak
*.backup
*.xlk
*.asd
*.wbk

# LibreOffice / OpenOffice lock files produced during cross-tool inspection.
.~lock.*#


#------------------------------------------------------------------------------
# GENERATED EXCEL / OFFICE BINARIES
#------------------------------------------------------------------------------
# The repository tracks the source used to build the component and demo.
# Generated Office packages belong in GitHub Releases, not in source control.
#
# These rules are global. A workbook saved at the repository root, under test/,
# or in an unexpected folder must remain untracked just as one under demo/.
#------------------------------------------------------------------------------

# Excel workbooks, templates, add-ins and legacy/binary formats
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

# Adjacent macro-enabled or database Office formats that are not project source
*.docm
*.dotm
*.pptm
*.potm
*.ppsm
*.accdb
*.accde
*.accdr
*.mdb
*.mde
*.ade

# If a binary fixture ever genuinely belongs in source control, re-include it
# by EXPLICIT path so that the exception is visible in code review, and update
# tools/check_repo.py in the same commit.
#
# Example:
# !test/fixtures/known-good-example.xlsm


#------------------------------------------------------------------------------
# RELEASE-ASSET / LOCAL BUILD STAGING
#------------------------------------------------------------------------------
# Generated binaries, hashes, manifests, or evidence being prepared for a
# GitHub Release may be staged locally under these directories.
#------------------------------------------------------------------------------

release-assets/
dist/
build/
out/
output/
outputs/


#------------------------------------------------------------------------------
# REGRESSION / CERTIFICATION / LOCAL TEST OUTPUT
#------------------------------------------------------------------------------
# The committed regression harness is source:
#
#   test/M_EXCEL_UI_REGRESSION_TESTS.bas
#
# Local output produced while investigating, certifying, or automating tests is
# not source. Final evidence is attached through the release process.
#------------------------------------------------------------------------------

test-output/
test-results/
coverage/
.coverage
.tox/

EXCEL_UI_certification_*.json
EXCEL_UI_certification_*.txt


#------------------------------------------------------------------------------
# LOCAL TEMPORARY WORKING DIRECTORIES
#------------------------------------------------------------------------------

temp/
tmp/
.cache/


#------------------------------------------------------------------------------
# WINDOWS FILE-SYSTEM / SHELL METADATA
#------------------------------------------------------------------------------

Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump

# Windows reserved-name artifact occasionally created by redirection mistakes.
nul


#------------------------------------------------------------------------------
# MACOS / NETWORK / UNIX FILE-SYSTEM METADATA
#------------------------------------------------------------------------------
# Excel for Windows is the production target, but the repository may be
# inspected from macOS, WSL, containers, NAS shares, or CI runners.
#------------------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Trashes
.Spotlight-V100
.fseventsd

.directory
.fuse_hidden*
.nfs*


#------------------------------------------------------------------------------
# EDITOR / IDE / AI-ASSISTANT LOCAL STATE
#------------------------------------------------------------------------------
# Deliberate project-wide configuration can be added later by explicit
# exception. Personal workspace state remains local.
#------------------------------------------------------------------------------

.vscode/
.idea/
.vs/
.history/

*.code-workspace
*.suo
*.user
*.swp
*.swo
*~

# Notepad++ backup/session artifacts
*.nppBackup
session.xml

# Local assistant/editor state
.claude/
.cursor/
.aider*
.continue/


#------------------------------------------------------------------------------
# MERGE / PATCH / CONFLICT ARTIFACTS
#------------------------------------------------------------------------------
# Exported VBA modules are large enough that .orig and .rej files can resemble
# legitimate importable source. Conflict debris must never enter the index.
#------------------------------------------------------------------------------

*.orig
*.rej
*.patch.tmp


#------------------------------------------------------------------------------
# LOGS / CRASH DUMPS / DIAGNOSTIC DEBRIS
#------------------------------------------------------------------------------

*.log
*.dmp
*.dump


#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET MATERIAL
#------------------------------------------------------------------------------
# Keep a deliberately sanitized example environment file trackable.
#------------------------------------------------------------------------------

.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key
*.pem


#------------------------------------------------------------------------------
# PYTHON / SCRIPTING CACHE AND LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# Repository tooling is version-controlled under tools/. Interpreter caches,
# test caches, notebooks, and local virtual environments are not.
#------------------------------------------------------------------------------

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

.venv/
venv/


#------------------------------------------------------------------------------
# NODE / JAVASCRIPT LOCAL DEPENDENCIES
#------------------------------------------------------------------------------
# Future documentation or repository-quality tooling may use Node. Source and
# package manifests remain trackable; installed dependencies do not.
#------------------------------------------------------------------------------

node_modules/


#------------------------------------------------------------------------------
# KEEP THESE AUTHORITATIVE REPOSITORY ASSETS TRACKABLE
#------------------------------------------------------------------------------
# These comments are intentional guardrails for future maintenance.
#
# Production VBA source:
#   src/M_EXCEL_UI.bas
#   src/M_EXCEL_UI_RUNTIME.bas
#   src/M_EXCEL_UI_SNAPSHOT.bas
#   src/M_EXCEL_UI_TITLEBAR.bas
#
# Demo source:
#   demo/M_EXCEL_UI_DEMO.bas
#   demo/M_DEMO_BUILDER.bas
#
# Regression source:
#   test/M_EXCEL_UI_REGRESSION_TESTS.bas
#
# Repository tooling:
#   tools/check_repo.py
#   tools/reformat.py
#   tools/public_api_manifest.txt
#
# Documentation / governance:
#   README.md
#   CHANGELOG.md
#   INSTALLATION.md
#   CONTRIBUTING.md
#   SECURITY.md
#   CODE_OF_CONDUCT.md
#   LICENSE
#   docs/**
#
# Repository configuration / automation:
#   .gitignore
#   .gitattributes
#   .github/**
#
# Visual documentation:
#   images/**
#
# Do not add broad ignore rules for source extensions or source directories.
# Generated Office binaries are GitHub Release assets, not repository source.
#==============================================================================
