#==============================================================================
# VBA-EXCEL_UI .gitattributes
#------------------------------------------------------------------------------
# PURPOSE
#   Define deterministic line-ending and binary-file handling for exported VBA
#   source, documentation, scripts, images, and Excel workbook artifacts.
#
# POLICY
#   - Exported VBA text uses CRLF, matching the Windows VBA Editor workflow.
#   - Repository documentation and configuration use LF.
#   - Excel workbooks, form binaries, archives, and images are never normalized.
#==============================================================================

#------------------------------------------------------------------------------
# DEFAULT TEXT DETECTION
#------------------------------------------------------------------------------
* text=auto

#------------------------------------------------------------------------------
# EXPORTED VBA SOURCE
#------------------------------------------------------------------------------
# CRLF is required for stable import/export behavior in the Windows VBE and to
# prevent contributor operating systems from creating noisy line-ending diffs.
*.bas   text eol=crlf
*.cls   text eol=crlf
*.frm   text eol=crlf

# Binary companion generated by exported VBA UserForms
*.frx   binary

#------------------------------------------------------------------------------
# WINDOWS SCRIPT FILES
#------------------------------------------------------------------------------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.vbs   text eol=crlf

#------------------------------------------------------------------------------
# REPOSITORY DOCUMENTATION / CONFIGURATION
#------------------------------------------------------------------------------
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.csv           text eol=lf
*.svg           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

#------------------------------------------------------------------------------
# EXCEL / OFFICE BINARY ARTIFACTS
#------------------------------------------------------------------------------
# Never attempt line-ending normalization or textual diffing of Office packages.
*.xls   binary
*.xlsx  binary
*.xlsm  binary
*.xlsb  binary
*.xltx  binary
*.xltm  binary
*.xlam  binary

*.doc   binary
*.docx  binary
*.docm  binary
*.ppt   binary
*.pptx  binary
*.pptm  binary

#------------------------------------------------------------------------------
# ARCHIVES / INSTALLATION ARTIFACTS
#------------------------------------------------------------------------------
*.zip   binary
*.7z    binary
*.rar   binary
*.cab   binary

#------------------------------------------------------------------------------
# IMAGES / MEDIA
#------------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.pdf   binary
